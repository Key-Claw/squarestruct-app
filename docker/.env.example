# Copiar como docker/.env en EC2 antes de levantar Docker Compose.
# No subir secretos reales al repositorio.

MYSQL_ROOT_PASSWORD=cambia_root_mysql
DB_NAME=squarestruct
DB_USER=admin
DB_PASSWORD=cambia_password_mysql
JWT_SECRET=cambia_este_jwt_secret_largo

# Dejar vacio en produccion con nginx: el navegador llamara a /api.
VITE_API_URL=

# Opcional. Con nginx y mismo origen normalmente puede quedarse vacio.
# Ejemplo: http://IP_PUBLICA_EC2
CORS_ORIGIN=
